# Normalizacao de fim de linha.
#
# Go exige LF. Sem esta configuracao, em Windows com core.autocrlf=true a arvore
# de trabalho fica em CRLF e `gofmt -l` passa a acusar 100% dos arquivos, o que
# torna a verificacao de formatacao inutil.

* text=auto eol=lf

*.go   text eol=lf
*.md   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Fontes Delphi de referencia, caso venham a ser versionados aqui.
*.pas text eol=crlf
*.dfm text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.pfx binary
